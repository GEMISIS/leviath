flowchart TD
    ingest(ingest)
    split_logs(split logs)
    scan_worker(scan worker)
    analyze{{analyze}}
    script{{script}}
    report(report)
    summary(summary)
    ingest --> split_logs
    ingest -. dead_end .-> report
    split_logs ==>|×30 workers| scan_worker
    scan_worker ==>|merge| analyze
    analyze --> script
    analyze --> report
    script --> script
    script --> analyze
    script -. dead_end .-> report
    report --> summary
    classDef entry stroke-width:3px
    class ingest entry
