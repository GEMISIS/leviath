flowchart TD
    survey(survey)
    investigate(investigate)
    compare{{compare}}
    deep_dive{{deep dive}}
    summarize(summarize)
    summary(summary)
    challenge{{challenge}}
    polish(polish)
    investigate_workers[["researcher (sub-agent)"]]
    survey --> investigate
    survey -. dead_end .-> challenge
    investigate ==>|×12 workers| investigate_workers
    investigate_workers ==>|merge| compare
    investigate -. dead_end .-> challenge
    compare --> deep_dive
    compare --> challenge
    deep_dive --> compare
    deep_dive --> survey
    deep_dive --> challenge
    summarize --> polish
    challenge --> survey
    challenge --> summarize
    polish --> summary
    classDef entry stroke-width:3px
    class survey entry
