    gather -. dead_end .-> challenge
    investigate ==>|×12 workers| investigate_workers
    investigate_workers ==>|merge| analyze
    investigate -. dead_end .-> challenge
    analyze --> gather
    analyze --> follow_citations
    analyze --> challenge
    follow_citations --> analyze
    follow_citations -. dead_end .-> challenge
    synthesize --> polish
    challenge --> gather
    challenge --> synthesize
    polish --> summary
    classDef entry stroke-width:3px
    class gather entry
