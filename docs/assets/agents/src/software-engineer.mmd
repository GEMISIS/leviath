flowchart TD
    discover(discover)
    plan{{plan}}
    prototype{{prototype}}
    implement{{implement}}
    review(review)
    reassess(reassess)
    discover --> plan
    plan --> implement
    plan --> prototype
    plan --> plan
    prototype --> implement
    prototype --> plan
    prototype -. stuck .-> reassess
    implement --> review
    implement --> plan
    implement -. stuck .-> reassess
    review --> implement
    reassess --> implement
    classDef entry stroke-width:3px
    class discover entry
