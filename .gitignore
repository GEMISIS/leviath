# Rust
/target
**/*.rs.bk
*.pdb

# Cargo.lock is deliberately NOT ignored. Leviath ships a binary, not a library,
# so the lockfile is what makes a release reproducible: without it every CI run
# and every release build re-resolved ~400 transitive crates, a compromised patch
# release could land in a signed-off binary with nobody seeing a diff, and
# `cargo audit` could not run at all (it has nothing to audit).

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
/tmp

# Leviath specific
.leviath/
*.leviath-bundle

# Secrets — never commit environment files or key material. .env.example is the
# one allowed exception (a template with no real values).
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*

# Per-machine Claude Code settings (may hold local permission grants)
.claude/settings.local.json

tarpaulin-report.json
.claude/worktrees/

# LLVM coverage profiling data
*.profraw
*.profdata

# Coverage reports (cargo xtask coverage / cargo llvm-cov output). Not
# rooted: `cargo test -p xtask` runs with the xtask/ crate dir as cwd, so
# run_with's tests produce xtask/coverage/ there, not just <repo-root>/coverage/.
coverage/
plans/
