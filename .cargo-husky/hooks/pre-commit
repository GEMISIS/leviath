#!/usr/bin/env bash
set -euo pipefail

# Colors (suppressed when not a terminal)
if [ -t 1 ]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; NC=''
fi

fail() { echo -e "${RED}[pre-commit] FAIL: $*${NC}" >&2; exit 1; }
pass() { echo -e "${GREEN}[pre-commit] $*${NC}"; }
info() { echo -e "${YELLOW}[pre-commit] $*${NC}"; }

info "Running pre-commit checks..."

# 1. Format
info "Checking formatting..."
cargo fmt --all -- --check \
  || fail "cargo fmt check failed. Run 'cargo fmt --all' to fix."
pass "Format OK"

# 2. Clippy
info "Running clippy..."
cargo clippy --all-targets --all-features -- -D warnings \
  || fail "cargo clippy failed. Fix the warnings above."
pass "Clippy OK"

# 3. Tests
info "Running tests..."
cargo test --all \
  || fail "Tests failed. Fix the failing tests above."
pass "Tests OK"

# 4. No coverage-suppression markers
info "Checking for coverage suppression markers..."
cargo xtask check-exclusions \
  || fail "Coverage suppression markers found. Remove them and refactor instead."
pass "No suppression markers OK"

# 5. Coverage ceiling not silently raised (compares the working tree against
# the last commit -- this is a pre-commit hook, so HEAD hasn't advanced yet).
info "Checking the coverage ceiling wasn't raised..."
cargo xtask check-ceiling \
  || fail "Coverage ceiling was raised -- see the message above for what's required to do that legitimately."
pass "Coverage ceiling OK"

pass "All pre-commit checks passed."
