[agent]
name = "model-to-animated-model"
version = "0.2.0"
description = "Rig an existing 3D model and apply an animation with Meshy"
entry_stage = "animate"

# Attach the mesh with `--attach <file.glb>:source_model`, and name the action
# as the task ("walk", "run", "jump" ...); it defaults to a walk. Meshy rigs the
# model, looks the action up in its animation library, and applies it. Set
# MESHY_API_KEY (or `lev setup` and choose Meshy) first - no text model needed.
#
# A pure "mesh in, animated mesh out" pipeline: one Meshy stage does the rig and
# the animation, declares the animated mesh as its artifact, and routes it into
# the animated region, so the run hands it back directly with no closing text
# stage and no text provider.

# The action to apply, as the task text.
[context.regions.task]
kind = "pinned"
budget = "10%"

# The mesh to animate, attached by the caller.
[context.regions.source_model]
kind = "pinned"
budget = "40%"
accepts = ["model/*"]

[context.regions.conversation]
kind = "sliding_window"
max_items = 8
max_tokens = 4000
budget = "10%"

# The finished animated mesh - what the run hands back.
[context.regions.animated]
kind = "sliding_window"
max_items = 1
budget = "20%"
accepts = ["model/*"]

[stages.animate]
mode = "output"
description = "Meshy rigs the model, applies the requested animation, and hands it back"
max_iterations = 3

[stages.animate.model]
allow_user_default = false
# Rig plus animate is two Meshy jobs in a row, so allow a generous deadline.
request_timeout_secs = 1200

[[stages.animate.model.models]]
provider = "meshy"
model = "animate"

# The animated mesh becomes the run's `animation` artifact. Routing it here is
# what lets the run hand it back with no submit_output call.
[stages.animate.output_routing]
"model/*" = "animated"

[[stages.animate.output.artifacts]]
name = "animation"
type = "model/gltf-binary"
required = true
