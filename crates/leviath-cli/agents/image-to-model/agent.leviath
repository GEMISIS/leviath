[agent]
name = "image-to-model"
version = "0.2.0"
description = "Turn one character or object image into a textured 3D model with Meshy"
entry_stage = "build"

# Meshy is a first-class provider: set MESHY_API_KEY (or `lev setup` and choose
# Meshy) and this agent runs - no text model needed. Attach the picture with
# `--attach <file>:image`, and give a short palette or material note as the task
# to steer the texturing.
#
# This is a pure "picture in, mesh out" pipeline: one Meshy stage does the whole
# job. Because it declares its output as an artifact and routes the built mesh
# into the model region, the run hands that mesh back as its answer directly -
# no second stage and no text provider to write a closing sentence.

[context.regions.task]
kind = "pinned"
budget = "10%"

# The single input picture, attached by the caller.
[context.regions.image]
kind = "pinned"
budget = "40%"
accepts = ["image/*"]

# A one-turn conversation region so the produced turn has somewhere to land.
[context.regions.conversation]
kind = "sliding_window"
max_items = 8
max_tokens = 4000
budget = "10%"

# The built mesh, held as a reference plus a stand-in (not inlined bytes). This
# is what the run hands back: the build stage declares it as the `model`
# artifact and routes the produced mesh here.
[context.regions.model]
kind = "sliding_window"
max_items = 1
budget = "15%"
accepts = ["model/*"]

# The preview render Meshy returns beside the mesh, for a look at the result.
[context.regions.model_preview]
kind = "clearable"
budget = "20%"
accepts = ["image/*"]

[stages.build]
mode = "output"
description = "Meshy turns the attached image into a textured 3D model and hands it back"
# A provider stage: one deterministic submit, poll, download. No tool loop.
max_iterations = 3

[stages.build.model]
allow_user_default = false
# A Meshy job runs for minutes; give the provider room to poll to completion.
request_timeout_secs = 900

[stages.build.model.parameters]
should_remesh = true
target_polycount = 20000
enable_pbr = true
texture_resolution = "2k"

[[stages.build.model.models]]
provider = "meshy"
model = "image-to-3d"

# The image region is the input; hide the preview region so nothing but the
# input picture reaches Meshy as an image.
[stages.build.context]
hide = ["model_preview"]

# The built mesh becomes the run's `model` artifact; the preview goes to its own
# region for a look. Routing the mesh here is what lets the run hand it back
# with no submit_output call.
[stages.build.output_routing]
"model/*" = "model"
"image/*" = "model_preview"

[[stages.build.output.artifacts]]
name = "model"
type = "model/gltf-binary"
required = true
