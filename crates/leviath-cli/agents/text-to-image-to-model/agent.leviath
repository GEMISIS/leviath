[agent]
name = "text-to-image-to-model"
version = "0.1.0"
description = "Turn a text description into a reference image, then a 3D model"
entry_stage = "draw"

# A two-step pipeline: an image model draws a clean reference from the task, then
# Meshy turns that image into a 3D model. Needs an image-capable provider for the
# draw step (OpenRouter's image model by default) and MESHY_API_KEY for the build.

# The description of what to make, as the task text. It steers both the drawing
# and the texturing.
[context.regions.task]
kind = "pinned"
budget = "10%"

[context.regions.conversation]
kind = "sliding_window"
max_items = 8
max_tokens = 4000
budget = "10%"

# The drawn reference image (a window of one: the latest draw is what builds).
[context.regions.image]
kind = "sliding_window"
max_items = 1
budget = "30%"
accepts = ["image/*"]

# The built mesh.
[context.regions.model]
kind = "sliding_window"
max_items = 1
budget = "15%"
accepts = ["model/*"]

# The preview render Meshy returns beside the mesh.
[context.regions.model_preview]
kind = "clearable"
budget = "20%"
accepts = ["image/*"]

# ── 1. Draw a clean reference image from the description ──────────────────────

[stages.draw]
mode = "autonomous"
description = "Draw one clean reference image of the described subject"
max_iterations = 6
system_prompt = """
Draw a single clean reference image of the subject the task describes: a clear,
well-lit three-quarter view on a plain neutral background, smooth surfaces and
readable colors, the whole subject in frame. No text, no collage, no multiple
panels - one picture a 3D model can be built from.
"""

[stages.draw.model]
allow_user_default = false

[[stages.draw.model.models]]
provider = "openrouter"
model = "google/gemini-2.5-flash-image"

[stages.draw.output]
format = "image/*"

[stages.draw.output_routing]
"image/*" = "image"

[stages.draw.transitions.build]
hint = "Once one clean reference image is in the image region."
transform = "direct"
gate = { require_region_updated = "image", message = "Draw the reference image first, then it can be built into a model.", max_attempts = 4 }

# ── 2. Build a 3D model from the drawn image ──────────────────────────────────

[stages.build]
mode = "autonomous"
description = "Meshy turns the drawn image into a textured 3D model"
max_iterations = 3

[stages.build.model]
allow_user_default = false
request_timeout_secs = 900

[stages.build.model.parameters]
should_remesh = true
target_polycount = 20000
enable_pbr = true
texture_resolution = "2k"

[[stages.build.model.models]]
provider = "meshy"
model = "image-to-3d"

# Only the drawn image reaches Meshy; hide the preview and model regions.
[stages.build.context]
reset = ["conversation"]
hide = ["model_preview", "model"]

[stages.build.output_routing]
"model/*" = "model"
"image/*" = "model_preview"

[stages.build.transitions.finalize]
hint = "Once the built model is in the model region."
transform = "direct"
gate = { require_region_updated = "model", message = "The model region is empty - the Meshy build landed no mesh.", max_attempts = 2 }

# ── 3. Hand the model back as the run's artifact ──────────────────────────────

[stages.finalize]
mode = "output"
description = "Hand back the produced model as the run's artifact"
model = { models = ["claude-sonnet-5", "gpt-5.4-mini", "gemini-3.5-flash", { provider = "ollama", model = "qwen3.5:9b" }] }
max_iterations = 4
available_tools = ["context_read", "context_list"]
system_prompt = """
The model region holds the finished 3D model as a produced part - a .glb the
Meshy build just made. Call context_list on the model region to read the part's
exact name, then call submit_output with a `model` artifact whose `path` is that
part name (submit_output resolves a produced part by its name). In the answer,
say in one line what the model is.
"""

[stages.finalize.context]
reset = ["conversation"]
hide = ["image", "model_preview"]

[stages.finalize.transitions]

[[stages.finalize.output.artifacts]]
name = "model"
type = "model/gltf-binary"
required = true
