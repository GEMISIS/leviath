[agent]
name = "text-to-image-to-model"
version = "0.2.0"
description = "Turn a text description into a reference image, then a 3D model"
entry_stage = "draw"

# A two-step pipeline: an image model draws a clean reference from the task, then
# Meshy turns that image into a 3D model. Needs an image-capable provider for the
# draw step (OpenRouter's image model by default) and MESHY_API_KEY for the
# build. No text model is needed: the build stage hands the mesh back itself.

# The description of what to make, as the task text. It steers both the drawing
# and the texturing.
[context.regions.task]
kind = "pinned"
budget = "10%"

[context.regions.conversation]
kind = "sliding_window"
max_items = 8
max_tokens = 4000
budget = "10%"

# The drawn reference image (a window of one: the latest draw is what builds).
[context.regions.image]
kind = "sliding_window"
max_items = 1
budget = "30%"
accepts = ["image/*"]

# The built mesh - what the run hands back.
[context.regions.model]
kind = "sliding_window"
max_items = 1
budget = "15%"
accepts = ["model/*"]

# The preview render Meshy returns beside the mesh.
[context.regions.model_preview]
kind = "clearable"
budget = "20%"
accepts = ["image/*"]

# ── 1. Draw a clean reference image from the description ──────────────────────

[stages.draw]
mode = "autonomous"
description = "Draw one clean reference image of the described subject"
max_iterations = 6
system_prompt = """
Draw a single clean reference image of the subject the task describes: a clear,
well-lit three-quarter view on a plain neutral background, smooth surfaces and
readable colors, the whole subject in frame. No text, no collage, no multiple
panels - one picture a 3D model can be built from.
"""

[stages.draw.model]
allow_user_default = false

[[stages.draw.model.models]]
provider = "openrouter"
model = "google/gemini-2.5-flash-image"

[stages.draw.output]
format = "image/*"

[stages.draw.output_routing]
"image/*" = "image"

[stages.draw.transitions.build]
hint = "Once one clean reference image is in the image region."
transform = "direct"
gate = { require_region_updated = "image", message = "Draw the reference image first, then it can be built into a model.", max_attempts = 4 }

# ── 2. Build a 3D model from the drawn image and hand it back ─────────────────

[stages.build]
mode = "output"
description = "Meshy turns the drawn image into a textured 3D model and hands it back"
max_iterations = 3

[stages.build.model]
allow_user_default = false
request_timeout_secs = 900

[stages.build.model.parameters]
should_remesh = true
target_polycount = 20000
enable_pbr = true
texture_resolution = "2k"

[[stages.build.model.models]]
provider = "meshy"
model = "image-to-3d"

# Only the drawn image reaches Meshy; hide the preview and model regions so no
# stale render is fed back in. The produced mesh still routes into the model
# region below - routing writes there whether or not the stage shows it.
[stages.build.context]
reset = ["conversation"]
hide = ["model_preview", "model"]

# The built mesh becomes the run's `model` artifact, handed back with no
# submit_output call.
[stages.build.output_routing]
"model/*" = "model"
"image/*" = "model_preview"

[[stages.build.output.artifacts]]
name = "model"
type = "model/gltf-binary"
required = true
